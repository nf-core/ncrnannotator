/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.
    All reference files are bundled in tests/data/ — no external downloads needed.

    Use as follows:
        nextflow run nf-core/ncrnannotator -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Pipeline mode
    mode       = 'ensembl-vertebrates'

    // Small test genome: Takifugu rubripes chr1, first 500 kbp
    fasta      = "${projectDir}/tests/data/takifugu_chr1_500kb.fa"

    // Rfam reference files: 10-model subset (RF00001/2/3/4/5/7/25/26/01960/02543)
    rfam_cm    = "${projectDir}/tests/data/rfam_test.cm"
    rfam_seed  = "${projectDir}/tests/data/rfam_test.seed"
}
